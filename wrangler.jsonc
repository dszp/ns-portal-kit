{
  // Cloudflare Worker config for ns-portal-kit.
  //
  // Fork this, set NS_SERVER to your NetSapiens API host, add your route, and deploy. Every
  // integration is OFF until you configure it, so the baseline is a plain NetSapiens call-flow
  // viewer with nothing else running.
  //
  // Secrets are NEVER in this file — set them per environment with `wrangler secret put <NAME>`:
  //   RINGOTEL_API_KEY enables the Ringotel integration (absent ⇒ it does not run at all)
  //   RINGOTEL_LABEL / RINGOTEL_LABEL_SHORT   white-label display names (default "Ringotel")
  //   BRAND_NAME       your company name (default: unbranded, "NS Portal Kit")
  //   ONEBILL_TENANT_ID, ONEBILL_CLIENT_SECRET, ONEBILL_USERNAME, ONEBILL_PASSWORD (OneBill links; set
  //     the tenant id as a secret too if you would rather keep it out of this file — see CONFIG.md)
  //
  // Regenerate Env types after edits: `pnpm cf-typegen`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ns-portal-kit",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],

  // A *.workers.dev URL, so a fresh deploy is reachable and can tell you what to do next. That is safe
  // here because this Worker holds no credential for user traffic: every request must carry the calling
  // user's own ns_t, and one that does not is refused. Add a custom domain under `routes` when you have
  // one; you can set this false once you do.
  "workers_dev": true,

  // Defense-in-depth rate limit on ns_t live-checks (bounds forged-token upstream amplification against
  // your NetSapiens core). The Worker also runs an in-isolate per-IP limiter, so this binding is
  // optional — but declared here so a deploy picks it up automatically. No dashboard step; namespace_id
  // is any positive integer unique within your account. See src/worker.ts → liveCheckRateLimited.
  "ratelimits": [{ "name": "JWT_RATE_LIMITER", "namespace_id": "1000", "simple": { "limit": 100, "period": 60 } }],

  "vars": {
    // REQUIRED: your NetSapiens API host (no scheme). Base URL becomes https://{NS_SERVER}/ns-api/v2.
    "NS_SERVER": "api.example.com",

    // Cache-key namespace for THIS deployment. A single deployment can leave this alone.
    //
    // Set a DISTINCT value per environment as soon as you run more than one Worker on the same zone (say
    // production plus a staging copy). Cloudflare's `caches.default` is shared zone-wide, not per-Worker,
    // so identical values mean the two share one set of cached app-provider entries: production
    // invalidates a cached organization after a write, staging's next read immediately repopulates that
    // same key, and production then serves staging's data until the TTL lapses.
    //
    // Two traps worth knowing: `vars` are NOT inherited into `env.*` blocks, so a value here does not
    // reach them and each block needs its own; and do not try to derive it from the request hostname,
    // because `scheduled()` has no request and the cron would then use a different key than the fetch
    // path -- two caches that never see each other's writes.
    "CACHE_SCOPE": "default",

    // ── OPTIONAL: NetSapiens event subscriptions (src/nsEvents.ts) ────────────────────────────────
    // Leave unset and nothing changes: the receiver route is absent and the scheduled reconcile no-ops.
    // Setting all four below arms it. See SETUP.md for the full description.
    //   "NS_EVENTS": "auto",                 // "auto" (default) | "on" | "off"
    //   "NS_EVENTS_DOMAINS": "acme.example.com",  // CSV, or "*" for everything the write rail allows
    //   "NS_EVENTS_BASE_URL": "https://portal.example.com",  // THIS deployment's public origin.
    //        Must differ per deployment: subscription ownership is decided by post-url prefix, so two
    //        deployments sharing an origin would fight over one subscription set.
    // Secrets (never here) — `wrangler secret put <NAME>`:
    //   NS_EVENTS_PATH_SECRET  master key for the per-domain callback token
    //   NS_API_KEY             the background service identity, used when an event has no caller — the
    //        ONLY stored NetSapiens credential this Worker has, and it exists solely because an event
    //        arrives with nobody attached. Prefer a dedicated least-privilege key restricted by
    //        allowed-models / domain / ip-address.

    // REQUIRED for delegated/portal auth: the Manager Portal host that issues your ns_t.
    // There is deliberately no default — a default issuer would mean accepting tokens minted by a
    // portal you don't control. Comma-separate if one backend is fronted by several portal hostnames
    // (exact match, no wildcards).
    "NS_PORTAL_ISS": "manage.example.com",

    // NOT A STARTING POINT ON ITS OWN. This is half of a feature: it does nothing until your Manager
    // Portal loads the script this Worker serves. Hand your portal https://<your-worker-host>/p.js (the
    // basename is PRIMARY_BASENAME, default "p") — there is nothing for you to write. See SETUP.md.

    // The browser origin your injected JS runs on — normally your Manager Portal.
    "ALLOWED_ORIGINS": ""

    // ── Optional. Uncomment what you need; each is inert while unset. ──
    //
    // Branding. The shared library ships vendor-neutral themes, so your brand lives here, not in code.
    // "BRAND_ACCENT": "#1a6bb0",        // hex accent for the flow modal + a brand theme
    //
    // Access gating (service deployments behind Cloudflare Zero Trust). Set BOTH values to turn the
    // in-Worker check ON — ACCESS_AUD alone is NOT enough (the team domain builds the JWKS URL, so
    // without it the check cannot run). A half-configured deployment is refused rather than served:
    // the Worker will not use a stored token with nothing verifiable in front of it. Once on, it fails
    // closed, so a direct-route or *.workers.dev hit is refused even though a service token is
    // configured. Both values are public identifiers, safe to commit.
    // "ACCESS_AUD": "<your Access application AUD tag>",
    // "ACCESS_TEAM_DOMAIN": "yourteam.cloudflareaccess.com",
    //
    // Domain scoping. ALLOWED_DOMAINS is an app-layer allowlist on top of the token's own NS scope —
    // set it in dev to keep the tool off the wider fleet. BLOCKED_DOMAINS hides domains with nothing
    // to diagram.
    // "ALLOWED_DOMAINS": "acme,demo.12345.service",
    // "BLOCKED_DOMAINS": "0000.12345.service",
    //
    // Enrichment toggles.
    // "RINGOTEL_PRESENCE": "1",     // 🟢/🔴 presence circles (point-in-time, cached ≤10m)
    // "NS_DEVICE_DETAILS": "1"      // desk-phone model + registration presence
    //
    // ── OPTIONAL: OneBill billing reconciliation (src/onebill.ts) ─────────────────────────────────
    // Off unless ONEBILL_TENANT_ID plus the three ONEBILL_* secrets above are all set. The custom-field
    // group named below must already exist in OneBill — SETUP.md walks through declaring it.
    // "ONEBILL_TENANT_ID": "<your OneBill tenant id>",   // a secret instead, if this repo is public
    // "ONEBILL_BASE_URL": "https://api.example.com",     // only if yours is not the standard one
    // "ONEBILL_LINK_GROUP": "{\"group\":\"PBX\",\"ns\":\"NS\",\"valueField\":\"Domain\",\"qualifierField\":\"Site\"}",
    // "ONEBILL_USAGE_OFFERS": "Domain Usage",  // offers whose subscription identifier IS the domain
    // "ONEBILL_USAGE_IGNORE": "_OLD",          // substrings marking a retired identifier
    //
    // The rulebook: which of YOUR offers counts toward which inventory dimension. Unset, the account
    // panel is a fact sheet. Worked example in SETUP.md — do not copy someone else's product names.
    // "ONEBILL_RECURRING_RULES": "[{\"offer\":\"Seat\",\"counts\":\"extensions.withAnyDevice\",\"group\":\"Seats\"}]",
    //
    // Fax server hosts, from a fax number's dial-rule destination host. A number routed to one of these
    // counts as dids.fax instead of dids.total. Unset, nothing is a fax line.
    // "NS_FAX_SERVER_HOSTS": "203.0.113.7",
    //
    // What a device-name suffix means here - the part of a device name after the extension number, so
    // "1001wp" has suffix "wp". Setting this replaces the default legend (wp/m/t) rather than adding to
    // it, so restate the ones you want to keep. Omit "t" and Teams detection is off entirely. An app that
    // registers one suffix per platform needs one entry per suffix - the suffix is matched whole.
    // "NS_DEVICE_SUFFIXES": "{\"wp\":{\"label\":\"SNAPmobile Web\"},\"m\":{\"label\":\"SNAPmobile\"},\"t\":{\"label\":\"Teams\",\"teams\":true},\"ai\":{\"label\":\"Acme App iOS\"},\"aa\":{\"label\":\"Acme App Android\"},\"aw\":{\"label\":\"Acme App Windows\"}}"
  },

  // NB: do NOT also declare ALLOWED_ORIGINS / ALLOWED_DOMAINS in a .dev.vars file. A key present in
  // both is shadowed by the value here during `wrangler dev`, which silently disables the allowlist.

  // Optional: the OneBill account panel's baseline and assignment store. Without it the panel still
  // renders the inventory and the comparison; only per-item Accept/Clear, the accepted status and the
  // manual item-to-account assignment are absent.
  //
  //   npx wrangler d1 create <your-db-name>
  //   npx wrangler d1 migrations apply <your-db-name> --remote
  //
  // migrations/ holds 0001-0005 and `migrations apply` runs whichever this database has not seen, so
  // run it again after every update, not only the first time. APPLY BEFORE YOU DEPLOY: the baseline
  // reads name the current columns, so an unmigrated database makes the panel answer an error rather
  // than degrade. Two of them DELETE rows because the model changed under them: 0002 clears
  // billing_baseline, and 0003 clears billing_baseline_item AND billing_baseline - the item
  // acceptances and the group rows both. 0004 and 0005 delete nothing. See CONFIG.md -> ONEBILL_DB.
  //
  // "d1_databases": [{ "binding": "ONEBILL_DB", "database_name": "<your-db-name>", "database_id": "<id>" }],

  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } }

  // Multi-environment example — one codebase, isolated scripts, separate rollback:
  //
  // "env": {
  //   "prod": {
  //     "name": "ns-portal-kit-prod",
  //     "routes": [{ "pattern": "portal.example.com", "custom_domain": true }],
  //     "vars": { "NS_SERVER": "api.example.com", "NS_PORTAL_ISS": "manage.example.com", "CACHE_SCOPE": "prod" }
  //   }
  // }
}
